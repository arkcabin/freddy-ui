{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "form-3",
  "description": "Comprehensive account settings form with structured fields for name, email, password, and phone number, featuring icons, grouped inputs, and save actions.",
  "registryDependencies": [
    "button",
    "button-group",
    "field",
    "input",
    "input-group"
  ],
  "files": [
    {
      "path": "registry/blocks/form/3/settings-form.tsx",
      "content": "import { AtSign, EyeIcon, LockIcon, PhoneIcon } from \"lucide-react\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { ButtonGroup } from \"@/components/ui/button-group\";\r\nimport {\r\n  Field,\r\n  FieldContent,\r\n  FieldDescription,\r\n  FieldGroup,\r\n  FieldLabel,\r\n  FieldLegend,\r\n  FieldSeparator,\r\n  FieldSet,\r\n} from \"@/components/ui/field\";\r\nimport { Input } from \"@/components/ui/input\";\r\nimport {\r\n  InputGroup,\r\n  InputGroupAddon,\r\n  InputGroupButton,\r\n  InputGroupInput,\r\n} from \"@/components/ui/input-group\";\r\n\r\nexport function SettingsForm() {\r\n  return (\r\n    <div className=\"mx-auto w-full max-w-4xl\">\r\n      <FieldSet>\r\n        <FieldLegend className=\"text-4xl\">Account Settings</FieldLegend>\r\n        <FieldDescription>\r\n          Manage account and your personal information.\r\n        </FieldDescription>\r\n        <FieldSeparator />\r\n        <FieldGroup className=\"gap-5\">\r\n          <div className=\"rounded-xl border border-border/60 p-0.5\">\r\n            <Field\r\n              className=\"rounded-xl border bg-card px-4 py-8 shadow-xs dark:bg-card/50\"\r\n              orientation=\"responsive\"\r\n            >\r\n              <FieldContent>\r\n                <FieldLabel htmlFor=\"name\">Your Name</FieldLabel>\r\n                <FieldDescription>\r\n                  Please enter a display name you are comfortable with.\r\n                </FieldDescription>\r\n              </FieldContent>\r\n              <FieldContent>\r\n                <ButtonGroup className=\"w-full\">\r\n                  <Input id=\"name\" placeholder=\"Enter Your Name\" />\r\n                  <Button variant=\"outline\">Save</Button>\r\n                </ButtonGroup>\r\n                <FieldDescription>Max 32 characters</FieldDescription>\r\n              </FieldContent>\r\n            </Field>\r\n          </div>\r\n          <div className=\"rounded-xl border border-border/60 p-0.5\">\r\n            <Field\r\n              className=\"rounded-xl border bg-card px-4 py-8 shadow-xs dark:bg-card/50\"\r\n              orientation=\"responsive\"\r\n            >\r\n              <FieldContent>\r\n                <FieldLabel htmlFor=\"lastName\">Your Email</FieldLabel>\r\n                <FieldDescription>\r\n                  Please enter a valid email address.\r\n                </FieldDescription>\r\n              </FieldContent>\r\n              <FieldContent>\r\n                <ButtonGroup className=\"w-full\">\r\n                  <InputGroup>\r\n                    <InputGroupAddon>\r\n                      <AtSign />\r\n                    </InputGroupAddon>\r\n                    <InputGroupInput\r\n                      placeholder=\"Enter Your Email\"\r\n                      type=\"email\"\r\n                    />\r\n                  </InputGroup>\r\n                  <Button variant=\"outline\">Save</Button>\r\n                </ButtonGroup>\r\n                <FieldDescription>Should be unique</FieldDescription>\r\n              </FieldContent>\r\n            </Field>\r\n          </div>\r\n          <div className=\"rounded-xl border border-border/60 p-0.5\">\r\n            <Field\r\n              className=\"rounded-xl border bg-card px-4 py-8 shadow-xs dark:bg-card/50\"\r\n              orientation=\"responsive\"\r\n            >\r\n              <FieldContent>\r\n                <FieldLabel htmlFor=\"lastName\">Your Password</FieldLabel>\r\n                <FieldDescription>\r\n                  please create a strong password\r\n                </FieldDescription>\r\n              </FieldContent>\r\n              <FieldContent>\r\n                <ButtonGroup className=\"w-full\">\r\n                  <InputGroup>\r\n                    <InputGroupAddon>\r\n                      <LockIcon />\r\n                    </InputGroupAddon>\r\n                    <InputGroupInput placeholder=\"XXxxXXX\" type=\"password\" />\r\n                    <InputGroupAddon align=\"inline-end\">\r\n                      <InputGroupButton>\r\n                        <EyeIcon />\r\n                      </InputGroupButton>\r\n                    </InputGroupAddon>\r\n                  </InputGroup>\r\n                  <Button variant=\"outline\">Save</Button>\r\n                </ButtonGroup>\r\n                <FieldDescription>\r\n                  Min 8 characters, Max 16 characters\r\n                </FieldDescription>\r\n              </FieldContent>\r\n            </Field>\r\n          </div>\r\n          <div className=\"rounded-xl border border-border/60 p-0.5\">\r\n            <Field\r\n              className=\"rounded-xl border bg-card px-4 py-8 shadow-xs dark:bg-card/50\"\r\n              orientation=\"responsive\"\r\n            >\r\n              <FieldContent>\r\n                <FieldLabel htmlFor=\"lastName\">Your Phone Number</FieldLabel>\r\n                <FieldDescription>\r\n                  please provide your phone number\r\n                </FieldDescription>\r\n              </FieldContent>\r\n              <FieldContent>\r\n                <ButtonGroup className=\"w-full\">\r\n                  <InputGroup>\r\n                    <InputGroupAddon>\r\n                      <PhoneIcon />\r\n                    </InputGroupAddon>\r\n                    <InputGroupInput placeholder=\"+91 1234567890\" type=\"tel\" />\r\n                  </InputGroup>\r\n                  <Button variant=\"outline\">Save</Button>\r\n                </ButtonGroup>\r\n                <FieldDescription>Min 10 characters</FieldDescription>\r\n              </FieldContent>\r\n            </Field>\r\n          </div>\r\n        </FieldGroup>\r\n      </FieldSet>\r\n    </div>\r\n  );\r\n}\r\n",
      "type": "registry:component",
      "target": "components/freddy-ui/form-3/settings-form.tsx"
    }
  ],
  "categories": [
    "form"
  ],
  "type": "registry:block"
}